# PORT & BIND_HOST
# - Di Docker: biarkan BIND_HOST=0.0.0.0 karena host port sudah dikunci di 127.0.0.1:3006:3006
# - Di VPS non-Docker (PM2/systemd): ubah BIND_HOST=127.0.0.1 agar port 3006 tidak tampil di Shodan
PORT=3006
BIND_HOST=127.0.0.1

# Konfigurasi PostgreSQL Privat (Hanya di jaringan internal Docker — TIDAK diekspos ke internet)
PG_HOST=smartolt-postgres
PG_PORT=5436
PG_USER=likhin
# WAJIB isi password acak minimal 24 karakter (contoh generate: openssl rand -base64 32)
PG_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_MINIMAL_24_KARAKTER
PG_DATABASE=smartolt_db
# Set true jika konek ke PostgreSQL eksternal via TLS
PG_SSL=false

# Password awal akun superadmin/admin (WAJIB ubah sebelum deploy produksi)
ADMIN_DEFAULT_PASSWORD=GANTI_PASSWORD_SUPERADMIN_YANG_KUAT

# Local SQLite fallback cache
SQLITE_PATH=./data/smartolt_live.sqlite

# GEMINI_API_KEY & APP_URL (AI Studio Runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
