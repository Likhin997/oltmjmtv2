# PORT: Port aplikasi web (3006 di Docker, 3000 di AI Studio preview)
PORT=3006

# Konfigurasi PostgreSQL (Terpisah — Konek ke localhost Port 5436)
# Default port PostgreSQL adalah 5432, diubah menjadi 5436
PG_HOST=localhost
PG_PORT=5436
PG_USER=likhin
PG_PASSWORD=
PG_DATABASE=smartolt_db

# Local SQLite fallback cache
SQLITE_PATH=./data/smartolt_live.sqlite

# GEMINI_API_KEY & APP_URL (AI Studio Runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
